# Kopieren nach .env und ausfüllen. Die .env wird NICHT ins Git-Repository übernommen.

# API-Key aus https://resend.com/api-keys (Berechtigung "Sending access" reicht)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Wohin die Nachrichten aus dem Kontaktformular gehen
MAIL_TO=pusteblume.kt@gmail.com

# Absender – muss zur in Resend verifizierten Domain gehören
MAIL_FROM=Pusteblume Website <kontakt@pusteblume-kt.de>

# 1, wenn ein Reverse Proxy (nginx, Caddy, Traefik, …) davor läuft
TRUST_PROXY=1
